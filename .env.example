# FuelWise NSW — environment variables
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Only the VITE_-prefixed var reaches the browser.
#
# Get the keys:
#   - Mapbox token:        https://account.mapbox.com  (public, URL-restrict it)
#   - FuelCheck id+secret: https://api.nsw.gov.au  → Applications → Fuel API
#   - OpenRouteService:    https://openrouteservice.org/dev → Tokens (geocode + routing)

# Client-side (public, bundled into the browser by design — restrict by URL in Mapbox).
VITE_MAPBOX_TOKEN=your-mapbox-public-token-here

# Server-side only (NEVER exposed to the client).
FUELCHECK_API_KEY=your-fuelcheck-client-id-here
FUELCHECK_API_SECRET=your-fuelcheck-client-secret-here
ORS_API_KEY=your-openrouteservice-token-here
